{
  "name": "ai-contribution-tracker",
  "displayName": "AI Contribution Tracker",
  "publisher": "YoavLax",
  "description": "Tracks AI coding assistant usage metrics",
  "version": "2.0.0",
  "contributors": [
    "Yoav Lax",
    "David Exterman"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YoavLax/AI-Contribution-Tracker"
  },
  "bugs": {
    "url": "https://github.com/YoavLax/AI-Contribution-Tracker/issues"
  },
  "homepage": "https://github.com/YoavLax/AI-Contribution-Tracker#readme",
  "keywords": [
    "ai",
    "copilot",
    "github-copilot",
    "git",
    "commit",
    "tracking",
    "metrics",
    "analytics",
    "productivity",
    "ai-assistant",
    "code-generation",
    "agentic-ai",
    "developer-tools"
  ],
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copilot-insight-tracker.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "copilotInsightTracker.acceptInlineSuggestion",
        "title": "Accept Inline Suggestion (Tracked)"
      },
      {
        "command": "copilotInsightTracker.acceptNextWord",
        "title": "Accept Next Word of Inline Suggestion (Tracked)"
      },
      {
        "command": "copilotInsightTracker.acceptNextLine",
        "title": "Accept Next Line of Inline Suggestion (Tracked)"
      }
    ],
    "keybindings": [
      {
        "command": "copilotInsightTracker.acceptInlineSuggestion",
        "key": "tab",
        "when": "copilotInsightTracker.active && inlineSuggestionVisible && !editorTabMovesFocus && !suggestWidgetVisible && !editorHoverFocused"
      },
      {
        "command": "copilotInsightTracker.acceptInlineSuggestion",
        "key": "tab",
        "when": "copilotInsightTracker.active && inlineEditVisible && !editorTabMovesFocus && !suggestWidgetVisible && !editorHoverFocused"
      },
      {
        "command": "copilotInsightTracker.acceptNextWord",
        "key": "ctrl+right",
        "mac": "cmd+right",
        "when": "copilotInsightTracker.active && inlineSuggestionVisible && !accessibilityModeEnabled"
      },
      {
        "command": "copilotInsightTracker.acceptNextLine",
        "key": "ctrl+shift+right",
        "mac": "cmd+shift+right",
        "when": "copilotInsightTracker.active && inlineSuggestionVisible"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.100.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  },
  "dependencies": {
    "axios": "^1.13.2"
  }
}
