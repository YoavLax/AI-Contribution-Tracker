{
  "name": "@tracker/ai-tracker",
  "version": "0.1.5",
  "description": "Standalone, self-contained CLI that tags every git commit with AI usage metadata (models, tokens, prompts). No VS Code required.",
  "bin": {
    "ai-track": "dist/ai-track.js"
  },
  "type": "module",
  "files": [
    "dist/ai-track.js"
  ],
  "scripts": {
    "build:js": "bun build ./src/cli.ts --target=node --outfile=dist/ai-track.js --external bun:sqlite --external node:sqlite",
    "build:bin": "bun run scripts/build-binaries.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "git",
    "commit",
    "tracking",
    "copilot",
    "claude-code",
    "opencode",
    "tokens",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YoavLax/AI-Contribution-Tracker.git"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
