@startuml AI Detection and Commit Tagging Flow

!theme plain

' ============================================
' COLOR DEFINITIONS
' ============================================
!define DeveloperColor #E8F5E9
!define VSCodeColor #E1F5FE
!define ExtensionColor #F3E5F5
!define GitColor #FFF3E0
!define AIToolColor #FFF9C4

' ============================================
' SKINPARAM SETTINGS
' ============================================
skinparam BoxPadding 0
skinparam BoxBorderColor black
skinparam BoxBorderThickness 2
skinparam sequenceArrowThickness 2
skinparam sequenceGroupBackgroundColor transparent
autonumber "<b>[000]"

title AI Contribution Tracker - Detection & Commit Tagging Flow

' ============================================
' COMPONENT DEFINITIONS
' ============================================

box "Developer" DeveloperColor
  actor "Developer\n(User)" as Dev
end box

box "AI Tool" AIToolColor
  participant "GitHub Copilot\n(Agent Mode / Chat)" as Copilot
end box

box "VS Code" VSCodeColor
  participant "Text Editor\n(Active Document)" as Editor
  participant "Document Events\n(onDidChangeTextDocument)" as DocEvents
end box

box "AI Contribution Tracker Extension" ExtensionColor
  participant "CopilotTracker\n(Extension)" as Tracker
  participant "Confidence Scorer\n(calculateAgenticConfidence)" as Scorer
end box

box "Git Repository" GitColor
  database ".git Directory\n(Flags & Hooks)" as GitDir
  participant "commit-msg Hook\n(Shell Script)" as Hook
end box

' ============================================
' PHASE 1: AI CODE GENERATION & DETECTION
' ============================================

== Phase 1: AI Code Generation & Confidence Scoring ==

Dev -> Copilot : Send prompt / request
activate Copilot

Copilot -> Editor : Generate & apply code changes
activate Editor

note right of Copilot
  AI modifies document(s)
  - Insertions
  - Deletions
  - Replacements
end note

Editor -> DocEvents : Trigger onDidChangeTextDocument
activate DocEvents
deactivate Editor

DocEvents -> Tracker : Forward TextDocumentChangeEvent
activate Tracker
deactivate DocEvents

Tracker -> Tracker : Check preconditions
note right of Tracker
  Skip if:
  - Pending inline accept
  - Undo/Redo operation
  - Non-file scheme
  - < 5 chars (typing)
end note

Tracker -> Scorer : Calculate confidence score
activate Scorer

Scorer -> Scorer : Evaluate 14 signals

note right of Scorer
  **Negative Signals:**
  • -50: Recent paste (< 500ms)
  
  **Positive Signals:**
  • +35: VS Code unfocused
  • +30: Background document
  • +25: Multi-file changes
  • +40/+20: No recent typing
  • +20: Fast insertion rate
  • +20: Chat panel visible
  • +15: Pure insertion
  • +15/+8: Large/medium block
  • +10: Markdown formatting
  • +10: Code structure
  • +5: Complete statements
  • +30/+20: Sustained background
  • +25/+15: Large deletion
  • +15: Background replacement
end note

Scorer --> Tracker : Return confidence score (0-100%)
deactivate Scorer

alt Score >= Threshold (default 70%)
    Tracker -> Tracker : Update _highestConfidenceScore
    Tracker -> GitDir : Write AI_IMPACT_PENDING flag
    activate GitDir
    
    note right of GitDir
      Flag content:
      "Impacted by AI (Agentic - 85% confidence)"
    end note
    
    GitDir --> Tracker : Flag written
    deactivate GitDir
    
    Tracker -> Tracker : Log: "✓ AGENTIC DETECTED"
else Score < Threshold
    Tracker -> Tracker : Log: "Below threshold"
end alt

deactivate Tracker
deactivate Copilot

' ============================================
' PHASE 2: COMMIT & TAGGING
' ============================================

== Phase 2: Git Commit & AI Impact Tagging ==

Dev -> GitDir : git commit -m "feat: add feature"
activate GitDir

GitDir -> Hook : Execute commit-msg hook
activate Hook

Hook -> GitDir : Read AI_IMPACT_PENDING flag
activate GitDir
GitDir --> Hook : Return flag content
deactivate GitDir

alt Flag exists
    Hook -> Hook : Parse marker type\n(Inline / Agentic / Both)
    
    Hook -> Hook : Append footer to commit message
    
    note right of Hook
      Original: "feat: add feature"
      
      Updated: "feat: add feature
      
      Impacted by AI (Agentic - 85% confidence)"
    end note
    
    Hook -> GitDir : Delete AI_IMPACT_PENDING flag
    activate GitDir
    GitDir --> Hook : Flag deleted
    deactivate GitDir
    
    Hook --> GitDir : Return success (exit 0)
else No flag exists
    Hook --> GitDir : Return success (no changes)
end alt

deactivate Hook

GitDir --> Dev : Commit completed with AI tag
deactivate GitDir

note over Dev, GitDir
  The commit message now includes
  "Impacted by AI" footer for traceability
end note

@enduml
